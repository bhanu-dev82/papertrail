# Set MOCK_MODE=true to run with no API keys (canned demo data)
MOCK_MODE=false
NEBIUS_API_KEY=
TAVILY_API_KEY=

# Per-role base URLs (Token Factory is OpenAI-compatible)
NEBIUS_BASE_URL_VISION=https://api.tokenfactory.nebius.com/v1/
NEBIUS_BASE_URL_FAST=https://api.tokenfactory.nebius.com/v1/
NEBIUS_BASE_URL_REASON=https://api.tokenfactory.us-central1.nebius.com/v1/

# Model IDs (from Nebius Token Factory model catalog)
MODEL_VISION=nvidia/Nemotron-3.5-Super-VL
MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_REASON=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_FALLBACK=nvidia/nemotron-3-super-120b-a12b

REQUEST_TIMEOUT_SECONDS=90
